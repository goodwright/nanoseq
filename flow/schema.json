{
    "inputs": [
        {
            "name": "Sample options",
            "description": "Samples to analyse",
            "advanced": false,
            "params": {
                "input": {
                    "name": "Samples",
                    "required": true,
                    "type": "csv",
                    "takes_samples": true,
                    "sample_types": ["NanoSeqBam"],
                    "columns": [
                        {
                            "name": "group",
                            "type": "string",
                            "required": true,
                            "from_sample": "group",
                            "render": true
                        },
                        {
                            "name": "replicate",
                            "type":  "number",
                            "from_sample": "replicate",
                            "required": true,
                            "render": true
                        },
                        {
                            "name": "barcode",
                            "type": "string",
                            "required": false,
                            "render": true
                        },
                        {
                            "name": "input_file",
                            "type":  "data",
                            "from_sample": 1,
                            "required": true,
                            "render": false
                        },
                        {
                            "name": "genome",
                            "required": true,
                            "type":  "data",
                            "pattern": "^\\S+\\.fn?a(sta)?(\\.gz)?$",
                            "render": true
                        },
                        {
                            "name": "transcriptome",
                            "required": true,
                            "type":  "data",
                            "pattern": "^\\S+\\.gtf(\\.gz)?$",
                            "render": true
                        }
                    ]
                },
                "protocol": {
                    "name": "Protocol",
                    "required": true,
                    "type": "string",
                    "valid": ["DNA", "cDNA", "directRNA"]
                },
                "skip_demultiplexing": {
                    "name": "Skip demultiplexing",
                    "type": "boolean",
                    "default": true
                },
                "skip_alignment": {
                    "name": "Skip alignment",
                    "type": "boolean",
                    "default": true
                }
            }
        }
    ],
    "outputs": [
        {
            "name": "MultiQC report",
            "description": "Results generated by MultiQC for this pipeline collate QC from FastQC, samtools flagstat, samtools idxstats and samtools stats.",
            "filetype": "html",
            "process": "MULTIQC"
        }
    ]
}
